####################################################
# WeatherGX Environment Configuration
####################################################

########################
# OpenWeather
########################

OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

########################
# Discord Bot
########################

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_SERVER_ID

CHANNEL_NAME=WRX001

########################
# Web Server
########################

HOST=0.0.0.0
PORT=5000

########################
# Default Weather Location
########################

DEFAULT_CITY=Brisbane
DEFAULT_COUNTRY=AU

DEFAULT_LAT=-27.4698
DEFAULT_LON=153.0251

########################
# Units
########################

UNITS=metric
LANGUAGE=en

########################
# Refresh Times (seconds)
########################

WEATHER_REFRESH=600
FORECAST_REFRESH=1800
ALERT_REFRESH=300

########################
# Globe
########################

DEFAULT_GLOBE_ROTATION_SPEED=0.15
ENABLE_GLOBE_CLOUDS=true
ENABLE_STARS=true

########################
# Logging
########################

LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=discord.log

########################
# User Data
########################

USER_LOCATION_FILE=user_locations.json
SAVE_USER_LOCATIONS=true

########################
# Caching
########################

ENABLE_CACHE=true
CACHE_TIME=300

########################
# Development
########################

DEBUG=false
TEST_MODE=false

########################
# Security
########################

SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET

########################
# Version
########################

APP_NAME=WeatherGX
APP_VERSION=1.0.0
