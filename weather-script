# Parse supported locations
parts = re.split(r'\s{2,}', RAW_LOCATIONS.strip())
SUPPORTED_LOCATIONS = [p.strip() for p in parts if p.strip() and not (len(p.strip()) == 1 and p.strip().isupper())]
SUPPORTED_SET = set(SUPPORTED_LOCATIONS)

# =============================================================================
# USER LOCATION DATA
# =============================================================================
USER_DATA_FILE = "user_locations.json"
user_locations = {}

def load_user_locations():
    global user_locations
    if os.path.exists(USER_DATA_FILE):
        with open(USER_DATA_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            user_locations = {int(k): v for k, v in data.items()}

def save_user_locations():
    with open(USER_DATA_FILE, "w", encoding="utf-8") as f:
        json.dump({str(k): v for k, v in user_locations.items()}, f, ensure_ascii=False)

# =============================================================================
# LOCATION MATCHING
# =============================================================================
def find_matching_location(continent: str, state: str, city: str) -> str | None:
    candidates = []
    city = city.strip()

    if city in SUPPORTED_SET:
        candidates.append(city)

    if state:
        state_clean = state.strip().upper()
        if f"{city} {state_clean}" in SUPPORTED_SET:
            candidates.append(f"{city} {state_clean}")
        if f"{city} {state}" in SUPPORTED_SET:
            candidates.append(f"{city} {state}")

    if continent:
        if f"{city} {continent.strip()}" in SUPPORTED_SET:
            candidates.append(f"{city} {continent.strip()}")

    city_lower = city.lower()
    for loc in SUPPORTED_LOCATIONS:
        if city_lower in loc.lower() and loc not in candidates:
            candidates.append(loc)

    return candidates[0] if candidates else None

# =============================================================================
# WEATHER FETCH (using your exact API key)
# =============================================================================
API_KEY = "d8ee345fe826344f17a935d916bf2b20"
API_BASE = "https://api.openweathermap.org/data/2.5"

async def fetch_weather(location: str):
    url = f"{API_BASE}/weather?q={location}&appid={API_KEY}&units=metric"

    async with aiohttp.ClientSession() as session:
        async with session.get(url) as response:
            if response.status != 200:
                return f"❌ Weather service error (HTTP {response.status})."

            data = await response.json()

            if data.get("cod") != 200:
                return f"❌ {data.get('message', 'City not found')}"

            city_name = data.get("name", location)
            country = data.get("sys", {}).get("country", "")
            temp = data["main"]["temp"]
            feels_like = data["main"]["feels_like"]
            description = data["weather"][0]["description"]
            humidity = data["main"]["humidity"]
            wind_speed = data["wind"].get("speed", 0)

            embed = discord.Embed(
                title=f"🌤️ Weather in {city_name}" + (f", {country}" if country else ""),
                description=description.capitalize(),
                color=0x00bfff
            )
            embed.add_field(name="Temperature", value=f"**{temp}°C** (feels like **{feels_like}°C**)", inline=True)
            embed.add_field(name="Humidity", value=f"**{humidity}%**", inline=True)
            embed.add_field(name="Wind", value=f"**{wind_speed} m/s**", inline=True)
            embed.set_footer(text="Powered by OpenWeatherMap")
            return embed

