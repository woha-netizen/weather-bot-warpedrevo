@bot.tree.command(name="setlocation", description="Set your default location (Continent, State, City)")
@app_commands.describe(
    continent="Continent (optional)",
    state="State / Province / Country code (e.g. UK, SD, CA)",
    city="City name from the list"
)
async def setlocation(interaction: discord.Interaction, continent: str, state: str, city: str):
    matched = find_matching_location(continent, state, city)
    if matched:
        user_locations[interaction.user.id] = matched
        save_user_locations()
        embed = discord.Embed(title="✅ Location Saved", description=f"Your default location is now **{matched}**", color=0x00ff00)
        await interaction.response.send_message(embed=embed, ephemeral=True)
    else:
        await interaction.response.send_message(
            "❌ No matching location found.\nTry exact city + state (e.g. Aberdeen SD)", 
            ephemeral=True
        )


@bot.tree.command(name="weather", description="Get current weather for your saved location or override")
@app_commands.describe(city="Optional city name override")
async def weather(interaction: discord.Interaction, city: str = None):
    if city is None:
        if interaction.user.id not in user_locations:
            await interaction.response.send_message(
                "⚠️ No location set! Use `/setlocation Continent State City` first.", 
                ephemeral=True
            )
            return
        location = user_locations[interaction.user.id]
    else:
        matched = find_matching_location("", "", city)
        location = matched if matched else city

    result = await fetch_weather(location)

    if isinstance(result, discord.Embed):
        await interaction.response.send_message(embed=result)
    else:
        await interaction.response.send_message(result, ephemeral=True)


